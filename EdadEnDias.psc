Algoritmo EdadEnDias
	
	Edad<-0
	Edad2<-0
	Escribir "Ingrese primera edad"
	Leer Edad
	
	Escribir "Ingrese segunda edad"
	Leer Edad2
	
	
	Edad1Endias<-Edad*365
	Escribir "Tu edad en dias es de ",Edad1Endias," dias"
	
	
	Edad2Endias<-Edad2*365
	Escribir "Tu edad en dias es de ",Edad2Endias," dias"
	
FinAlgoritmo


